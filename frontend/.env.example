# ---------------------------------------------------------------------------
# Frontend configuration.
#
# LOCAL: copy this file to .env and leave the default.
#
# VERCEL: do NOT commit a .env. Set VITE_API_BASE_URL in
#   Project -> Settings -> Environment Variables, then redeploy.
#   Vite inlines this at BUILD time, so changing it requires a rebuild,
#   not just a restart.
#
# The value must be your backend's public https:// URL with no trailing slash,
# e.g. https://oral-cancer-api.onrender.com
# It must also appear in the backend's ALLOWED_ORIGINS, or CORS will block it.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
