# ---------------------------------------------------------------------------
# Oral Cancer Classifier -- backend configuration
# Copy to .env and adjust. Every value below is optional; the defaults match
# the EXP-4A checkpoint.
# ---------------------------------------------------------------------------

# Path to the trained checkpoint. Absolute, or relative to backend/.
MODEL_PATH=models/EfficientNetB0_Dataset02_OralCancer_EXP4A.pkl

# auto | cpu | cuda   ("auto" uses CUDA when available, else CPU)
DEVICE=auto

# Torch intra-op threads. Keep at 1 on any host that gives you a fractional CPU
# (Render, Railway, Fly). Torch otherwise sizes its pool from the host's core
# count, spawns more workers than the cgroup quota allows, and gets throttled --
# turning a ~50 ms forward pass into several seconds. Raise only on a box with
# whole cores to spare.
TORCH_NUM_THREADS=1

# --- Decision layer --------------------------------------------------------
# P(Cancer) at or above this is reported as Cancer. Raise it to reduce false
# positives, lower it to reduce false negatives.
THRESHOLD=0.5

# Which class index counts as "Cancer".
# VERIFIED against the checkpoint metadata: class_names = {0: NON CANCER, 1: CANCER}
POSITIVE_CLASS_INDEX=1

# Does the model already apply sigmoid/softmax internally?
# EXP-4A does NOT (its dummy forward spans [-1406, +242] -- raw logits), so the
# server applies sigmoid itself. Setting this to true here would squash every
# prediction toward 0.5.
MODEL_OUTPUTS_PROBABILITY=false

# --- Preprocessing (fallbacks; the checkpoint's own metadata takes priority) -
INPUT_SIZE=224

# resize      -> Resize((224, 224))                  <- EXP-4A trained on a pre-resized dataset
# resize_crop -> Resize(256) + CenterCrop(224)
# Change this if your training notebook's VALIDATION transform used the latter.
RESIZE_MODE=resize
CENTER_CROP_RATIO=0.875

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_BATCH_FILES=10

# --- Model delivery (deployment) -------------------------------------------
# Weights are gitignored, so a freshly deployed instance has no .pkl. Set this
# to a DIRECT-download link and it is fetched once at startup and cached.
# A Google Drive or Dropbox *sharing page* will not work -- it returns HTML,
# which the loader detects and rejects with a clear message.
# Leave empty when the file is present on disk (the normal local case).
MODEL_URL=

# Optional integrity check on that download:  sha256sum <your>.pkl
MODEL_SHA256=

# Bearer token, if MODEL_URL requires authentication (private bucket, private
# Hugging Face repo). Sent as `Authorization: Bearer <token>`. A presigned URL
# carries its own credentials and needs no token. Set this in your host's
# dashboard -- never commit it.
MODEL_AUTH_TOKEN=

# --- Server ----------------------------------------------------------------
# Local only. Render/Railway/Fly inject $PORT and the start command uses it.
PORT=8000

# Comma-separated CORS origins. Add your deployed frontend origin here, e.g.
#   ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Vite falls back to 5174/5175 when 5173 is taken, so those are listed too.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Vercel gives every preview deployment its own hostname, so they cannot be
# listed one by one. This regex must match the WHOLE origin. Example:
#   ALLOWED_ORIGIN_REGEX=https://your-app-.*-yourteam\.vercel\.app
# Leave empty to allow only the exact origins above.
ALLOWED_ORIGIN_REGEX=

LOG_LEVEL=INFO
